{
  "title": "Pod Monitoring: CPU / Memory / Network / Logs",
  "uid": "pod-monitoring-full",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "efo77zjxxwmpsa"
        },
        "query": "label_values(container_cpu_usage_seconds_total, namespace)",
        "refresh": 1
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "efo77zjxxwmpsa"
        },
        "query": "label_values(container_cpu_usage_seconds_total{namespace=\"$namespace\"}, pod)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU cores",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "efo77zjxxwmpsa"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"$pod\",container!=\"\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "efo77zjxxwmpsa"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"$pod\",container!=\"\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Containers",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "efo77zjxxwmpsa"
      },
      "targets": [
        {
          "expr": "count(count by (pod,container) (container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"$pod\",container!=\"\"}))"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Network RX/TX",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "efo77zjxxwmpsa"
      },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "RX"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU usage by pod/container",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "efo77zjxxwmpsa"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"$pod\",container!=\"\"}[5m])) by (pod,container)",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory usage by pod/container",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "efo77zjxxwmpsa"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"$pod\",container!=\"\"}) by (pod,container)",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network I/O by pod",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "efo77zjxxwmpsa"
      },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m])) by (pod)",
          "legendFormat": "{{pod}} RX"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m])) by (pod)",
          "legendFormat": "{{pod}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Pod logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "dfo77erhx5xxcd"
      },
      "targets": [
        {
          "expr": "{kubernetes.pod_namespace=\"$namespace\",kubernetes.pod_name=~\"$pod\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 12
      }
    }
  ]
}
